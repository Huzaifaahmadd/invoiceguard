      "id": "a2e85b08-894d-423b-a107-184d44160ab4",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  vendor_norm,\n  COALESCE(SUM(total) FILTER (WHERE created_at >= now() - interval '7 days'), 0) AS this_week,\n  COALESCE(SUM(total) FILTER (WHERE created_at < now() - interval '7 days'\n                              AND created_at >= now() - interval '14 days'), 0) AS last_week\nFROM invoices\nWHERE status = 'approved'\n  AND created_at >= now() - interval '14 days'\nGROUP BY vendor_norm\nORDER BY this_week DESC;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        160,
        -16
      ],
      "id": "1fc1f989-2bbc-4a02-ae3d-b654601bc76c",
      "name": "Weekly Totals",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "Ebp9aKdxQJzI4yeR",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Take the rows from the database (ignore the empty row if there are none)\nconst rows = $input.all().map(i => i.json).filter(r => r.vendor_norm);\n\nconst thisTotal = rows.reduce((s, r) => s + Number(r.this_week), 0);\nconst lastTotal = rows.reduce((s, r) => s + Number(r.last_week), 0);\n\nconst lines = rows.map(r =>\n  `${r.vendor_norm}: this week ${r.this_week}, last week ${r.last_week}`\n);\n\nreturn [{\n  json: {\n    thisTotal,\n    lastTotal,\n    vendorLines: rows.length ? lines.join(\"\\n\") : \"No approved invoices in the last 14 days.\"\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        384,
        -16
      ],
