    {
      "parameters": {
        "jsCode": "// The reply text from the email form\nconst text = ($json.data?.text || \"\").trim();\nconst inv = $('Route by Risk').first().json;\n\n// Expected form: field | wrong value | right value\nconst parts = text.split(\"|\").map(s => s.trim());\nconst isCorrection = parts.length === 3 && parts.every(p => p.length > 0);\n\nreturn [{\n  json: {\n    isCorrection,\n    vendor_norm: (inv.vendor_name || '').toLowerCase().trim(),\n    field: parts[0] || null,\n    wrong_value: parts[1] || null,\n    right_value: parts[2] || null,\n    reply: text\n  }\n}];"
      },
