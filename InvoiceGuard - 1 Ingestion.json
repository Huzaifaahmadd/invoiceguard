    {
      "parameters": {
        "jsCode": "// Use the retried invoice if the retry path ran,\n// otherwise use the first extraction.\nlet inv;\ntry {\n  inv = $('Validate Retry').first().json;\n} catch (e) {\n  inv = $('Code in JavaScript').first().json;\n}\n\n// Database answers come from the Check Anomalies node.\nconst a = $input.first().json;\n\nconst flags = [];\nif (a.is_duplicate) flags.push(\"duplicate\");\nif (!a.known_vendor) flags.push(\"new_vendor\");\nif (a.known_bank && inv.vendor_bank_account &&\n    inv.vendor_bank_account !== a.known_bank) flags.push(\"bank_change\");\n\n// duplicate or bank change -> quarantine\n// any other flag           -> human review\n// no flags                 -> auto-approve\nlet route = \"auto\";\nif (flags.includes(\"duplicate\") || flags.includes(\"bank_change\")) {\n  route = \"quarantine\";\n} else if (flags.length > 0) {\n  route = \"review\";\n}\n\nreturn [{ json: { ...inv, flags, route } }];"
      },
