      "parameters": {
        "jsCode": "// How many years back an invoice date is allowed.\n// Normal value: 2. For testing the 2018 invoice we use 10.\nconst MAX_AGE_YEARS = 2;\n\nconst inv = $input.first().json.output;\nconst errors = [];\nconst r2 = n => Math.round((n + Number.EPSILON) * 100) / 100;\n\n// 1. Required fields\nif (!inv.vendor_name) errors.push(\"missing vendor_name\");\nif (!inv.invoice_number) errors.push(\"missing invoice_number\");\nif (!inv.total || inv.total <= 0) errors.push(\"invalid total\");\n\n// 2. Math: line items must add up to the subtotal\nconst lineSum = r2((inv.line_items || []).reduce((s, i) => s + (i.line_total ?? 0), 0));\nif (Math.abs(lineSum - (inv.subtotal ?? lineSum)) > 0.02)\n  errors.push(`line items ${lineSum} != subtotal ${inv.subtotal}`);\n\n// 3. Math: subtotal + tax must equal the total\nif (Math.abs(r2((inv.subtotal ?? 0) + (inv.tax_amount ?? 0)) - inv.total) > 0.02)\n  errors.push(\"subtotal + tax != total\");\n\n// 4. Date must be real, not in the future, and not too old\nconst d = new Date(inv.invoice_date);\nconst now = new Date();\nif (isNaN(d) || d > now || d < new Date(now.getFullYear() - MAX_AGE_YEARS, 0, 1))\n  errors.push(\"date out of range\");\n\nreturn [{\n  json: {\n    ...inv,\n    file_hash: $('Crypto').first().json.file_hash,\n    validation_errors: errors,\n    valid: errors.length === 0\n  }\n}];"
      },
